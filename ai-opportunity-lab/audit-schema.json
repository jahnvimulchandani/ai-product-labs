{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-opportunity-lab/audit-schema.json",
  "title": "AI Opportunity Lab Audit Output",
  "description": "Machine-readable contract for a completed AI Opportunity Lab audit after clarification and user confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_metadata",
    "decision",
    "opportunity",
    "evidence_register",
    "problem_strength",
    "business_value",
    "economics_and_alternatives",
    "readiness",
    "architecture",
    "risk_and_governance",
    "market_context",
    "opportunity_cost",
    "improvement_recommendations",
    "roadmap",
    "tester_flow",
    "scale_path",
    "metrics",
    "open_questions"
  ],
  "properties": {
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_version",
        "schema_version",
        "prompt_version",
        "model_provider",
        "model_id",
        "search_provider",
        "generated_at"
      ],
      "properties": {
        "framework_version": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "model_provider": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "search_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "confidence",
        "preferred_current_path",
        "executive_summary",
        "primary_reason",
        "largest_uncertainty"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PROCEED_TO_PILOT",
            "VALIDATE_VALUE",
            "PREPARE_DEPENDENCIES",
            "USE_SIMPLER_APPROACH",
            "HUMAN_LED_DO_NOT_AUTOMATE",
            "PARK"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "preferred_current_path": {
          "type": "string",
          "minLength": 1
        },
        "executive_summary": {
          "type": "string",
          "minLength": 1
        },
        "primary_reason": {
          "type": "string",
          "minLength": 1
        },
        "largest_uncertainty": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_idea",
        "affected_user",
        "problem",
        "current_workflow",
        "desired_outcome",
        "current_baseline",
        "existing_alternatives",
        "required_data",
        "required_systems",
        "expected_actions",
        "constraints",
        "business_owner"
      ],
      "properties": {
        "original_idea": {
          "type": "string",
          "minLength": 1
        },
        "affected_user": {
          "$ref": "#/$defs/evidenced_text"
        },
        "problem": {
          "$ref": "#/$defs/evidenced_text"
        },
        "current_workflow": {
          "$ref": "#/$defs/evidenced_text"
        },
        "desired_outcome": {
          "$ref": "#/$defs/evidenced_text"
        },
        "current_baseline": {
          "$ref": "#/$defs/evidenced_text"
        },
        "existing_alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenced_text"
          }
        },
        "required_data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenced_text"
          }
        },
        "required_systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenced_text"
          }
        },
        "expected_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenced_text"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenced_text"
          }
        },
        "business_owner": {
          "$ref": "#/$defs/evidenced_text"
        }
      }
    },
    "evidence_register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_facts",
        "supported_facts",
        "estimates",
        "assumptions",
        "unknowns"
      ],
      "properties": {
        "confirmed_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "supported_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "estimates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        }
      }
    },
    "problem_strength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "confidence",
        "problem_evidence",
        "frequency_or_volume",
        "severity",
        "reach",
        "workaround_quality",
        "outcome_measurability",
        "strongest_evidence",
        "missing_evidence",
        "baseline_metrics_needed"
      ],
      "properties": {
        "rating": {
          "type": "string",
          "enum": [
            "WEAK",
            "MODERATE",
            "STRONG"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "problem_evidence": {
          "$ref": "#/$defs/evidenced_text"
        },
        "frequency_or_volume": {
          "$ref": "#/$defs/evidenced_text"
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "reach": {
          "$ref": "#/$defs/evidenced_text"
        },
        "workaround_quality": {
          "$ref": "#/$defs/evidenced_text"
        },
        "outcome_measurability": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "strongest_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline_metrics_needed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "business_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_potential",
        "confidence",
        "primary_value_mechanism",
        "secondary_value_mechanisms",
        "baseline_status",
        "value_hypothesis",
        "adoption_assumptions",
        "owner",
        "calculation_inputs",
        "missing_variables"
      ],
      "properties": {
        "value_potential": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "primary_value_mechanism": {
          "type": "string",
          "enum": [
            "TIME_SAVED",
            "LABOR_COST_AVOIDED",
            "CAPACITY_CREATED",
            "ERROR_REDUCTION",
            "REVENUE",
            "CONVERSION",
            "RETENTION",
            "TURNAROUND_TIME",
            "RISK_REDUCTION",
            "DECISION_QUALITY",
            "CUSTOMER_EXPERIENCE",
            "STRATEGIC_CAPABILITY",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "secondary_value_mechanisms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline_status": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "PARTIAL",
            "MISSING"
          ]
        },
        "value_hypothesis": {
          "type": "string"
        },
        "adoption_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "calculation_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/calculation_input"
          }
        },
        "missing_variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "economics_and_alternatives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_attractiveness",
        "confidence",
        "current_process_baseline",
        "options",
        "dominant_alternative",
        "major_cost_drivers",
        "major_value_drivers",
        "missing_numbers"
      ],
      "properties": {
        "economic_attractiveness": {
          "type": "string",
          "enum": [
            "WEAK",
            "UNCLEAR",
            "PROMISING"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "current_process_baseline": {
          "$ref": "#/$defs/evidenced_text"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/economic_option"
          }
        },
        "dominant_alternative": {
          "type": [
            "string",
            "null"
          ]
        },
        "major_cost_drivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "major_value_drivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_numbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "confidence",
        "data",
        "integration",
        "process",
        "evaluation",
        "observability",
        "recovery",
        "ownership",
        "blocking_dependencies",
        "preparation_tasks"
      ],
      "properties": {
        "overall": {
          "$ref": "#/$defs/readiness_rating"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "data": {
          "$ref": "#/$defs/readiness_dimension"
        },
        "integration": {
          "$ref": "#/$defs/readiness_dimension"
        },
        "process": {
          "$ref": "#/$defs/readiness_dimension"
        },
        "evaluation": {
          "$ref": "#/$defs/readiness_dimension"
        },
        "observability": {
          "$ref": "#/$defs/readiness_dimension"
        },
        "recovery": {
          "$ref": "#/$defs/readiness_dimension"
        },
        "ownership": {
          "$ref": "#/$defs/readiness_dimension"
        },
        "blocking_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preparation_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best_current_fit",
        "simpler_alternative",
        "future_option",
        "candidates"
      ],
      "properties": {
        "best_current_fit": {
          "$ref": "#/$defs/architecture_pattern"
        },
        "simpler_alternative": {
          "anyOf": [
            {
              "$ref": "#/$defs/architecture_pattern"
            },
            {
              "type": "null"
            }
          ]
        },
        "future_option": {
          "anyOf": [
            {
              "$ref": "#/$defs/architecture_pattern"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/architecture_candidate"
          }
        }
      }
    },
    "risk_and_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_tier",
        "confidence",
        "stakes",
        "error_detectability",
        "reversibility",
        "blast_radius",
        "sensitive_data",
        "rights_impact",
        "adversarial_exposure",
        "accountable_owner",
        "hard_gates",
        "required_controls",
        "autonomy_limit",
        "human_review_required",
        "specialist_review_required"
      ],
      "properties": {
        "risk_tier": {
          "type": "string",
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "SPECIALIST_REVIEW"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "stakes": {
          "$ref": "#/$defs/evidenced_text"
        },
        "error_detectability": {
          "$ref": "#/$defs/evidenced_text"
        },
        "reversibility": {
          "$ref": "#/$defs/evidenced_text"
        },
        "blast_radius": {
          "$ref": "#/$defs/evidenced_text"
        },
        "sensitive_data": {
          "$ref": "#/$defs/evidenced_text"
        },
        "rights_impact": {
          "$ref": "#/$defs/evidenced_text"
        },
        "adversarial_exposure": {
          "$ref": "#/$defs/evidenced_text"
        },
        "accountable_owner": {
          "$ref": "#/$defs/evidenced_text"
        },
        "hard_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "HIGH_STAKES_LOW_DETECTABILITY",
              "IRREVERSIBLE_ACTION_WEAK_RECOVERY",
              "SENSITIVE_DATA_CONTROLS_UNKNOWN",
              "NO_ACCOUNTABLE_OWNER",
              "UNTRUSTED_CONTENT_WITH_TOOL_ACTIONS",
              "RISK_CRITICAL_INFORMATION_UNKNOWN"
            ]
          }
        },
        "required_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "autonomy_limit": {
          "type": "string"
        },
        "human_review_required": {
          "type": "boolean"
        },
        "specialist_review_required": {
          "type": "boolean"
        }
      }
    },
    "market_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_used",
        "supports",
        "neutral",
        "challenges",
        "research_summary"
      ],
      "properties": {
        "research_used": {
          "type": "boolean"
        },
        "supports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/market_signal"
          }
        },
        "neutral": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/market_signal"
          }
        },
        "challenges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/market_signal"
          }
        },
        "research_summary": {
          "type": "string"
        }
      }
    },
    "opportunity_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_proposed_solution",
        "choose_simpler_option",
        "delay",
        "do_nothing"
      ],
      "properties": {
        "build_proposed_solution": {
          "type": "string"
        },
        "choose_simpler_option": {
          "type": "string"
        },
        "delay": {
          "type": "string"
        },
        "do_nothing": {
          "type": "string"
        }
      }
    },
    "improvement_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change",
          "why",
          "expected_effect"
        ],
        "properties": {
          "change": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "expected_effect": {
            "type": "string"
          }
        }
      }
    },
    "roadmap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/roadmap_step"
      }
    },
    "tester_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "representative_sample",
        "baseline",
        "simplest_comparator",
        "proposed_test",
        "human_control",
        "success_criteria",
        "stop_criteria",
        "measurements",
        "failure_analysis",
        "go_no_go_rule",
        "steps"
      ],
      "properties": {
        "objective": {
          "type": "string"
        },
        "representative_sample": {
          "type": "string"
        },
        "baseline": {
          "type": "string"
        },
        "simplest_comparator": {
          "type": "string"
        },
        "proposed_test": {
          "type": "string"
        },
        "human_control": {
          "type": "string"
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_analysis": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DATA",
              "RETRIEVAL",
              "REASONING",
              "INSTRUCTION",
              "TOOL_INTEGRATION",
              "WORKFLOW",
              "ADOPTION",
              "RISK_CONTROL",
              "OTHER"
            ]
          }
        },
        "go_no_go_rule": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/test_step"
          }
        }
      }
    },
    "scale_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scale_stage"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_outcome_metric",
        "supporting_metrics",
        "ai_quality_metrics",
        "human_control_metrics",
        "economic_metrics"
      ],
      "properties": {
        "primary_outcome_metric": {
          "type": "string"
        },
        "supporting_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ai_quality_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_control_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "economic_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "why_it_matters",
          "blocking"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "SUPPORTED",
        "ESTIMATED",
        "ASSUMED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "evidenced_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence_status",
        "note"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "$ref": "#/$defs/evidence_status"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "source_kind",
        "source_reference",
        "why_it_matters"
      ],
      "properties": {
        "claim": {
          "type": "string"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "USER_INPUT",
            "EXTERNAL_SOURCE",
            "CALCULATION",
            "FRAMEWORK_RULE",
            "MODEL_INFERENCE",
            "UNKNOWN"
          ]
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "why_it_matters": {
          "type": "string"
        }
      }
    },
    "calculation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "evidence_status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "$ref": "#/$defs/evidence_status"
        }
      }
    },
    "architecture_pattern": {
      "type": "string",
      "enum": [
        "PROCESS_OR_HUMAN_CHANGE",
        "DETERMINISTIC_AUTOMATION",
        "PREDICTIVE_CLASSICAL_ML",
        "ASSISTIVE_LLM",
        "RETRIEVAL_GROUNDED_AI",
        "STRUCTURED_AI_WORKFLOW",
        "AGENTIC_SYSTEM"
      ]
    },
    "architecture_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "role",
        "expected_value",
        "implementation_burden",
        "ongoing_burden",
        "data_needs",
        "tool_needs",
        "human_role",
        "key_risks",
        "fit_summary",
        "current_fit"
      ],
      "properties": {
        "pattern": {
          "$ref": "#/$defs/architecture_pattern"
        },
        "role": {
          "type": "string"
        },
        "expected_value": {
          "type": "string"
        },
        "implementation_burden": {
          "type": "string",
          "enum": [
